<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Logo / Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="🐾"
            android:textSize="72sp"
            android:gravity="center"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PawAlert"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FF6B35"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Real-Time Stray Animal Emergency Response"
            android:textSize="13sp"
            android:textColor="#99AABB"
            android:gravity="center"/>

        <!-- Divider -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#FF6B35"/>

        <!-- Section Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧 Firebase Connection Status"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EAEAEA"
            android:layout_marginBottom="16dp"/>

        <!-- Firebase App Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_firebase_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 Firebase App: Checking..."
                android:textSize="14sp"
                android:textColor="#CCDDEE"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Auth Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 Auth: Checking..."
                android:textSize="14sp"
                android:textColor="#CCDDEE"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Firestore Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_firestore_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗄️ Firestore: Checking..."
                android:textSize="14sp"
                android:textColor="#CCDDEE"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- FCM Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_fcm_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📬 FCM: Checking..."
                android:textSize="14sp"
                android:textColor="#CCDDEE"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Check Button -->
        <Button
            android:id="@+id/btn_check_status"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:text="🔄 Re-Check Firebase Status"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>